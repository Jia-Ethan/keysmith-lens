---
import claude from "../assets/agents/claude.svg?raw";
import codex from "../assets/agents/codex.svg?raw";
import opencode from "../assets/agents/opencode.svg?raw";
import openhands from "../assets/agents/openhands.svg?raw";

export type AgentId = "claude" | "codex" | "opencode" | "openhands";
interface Props {
  agent: AgentId;
  class?: string;
}
const { agent, class: cls } = Astro.props;
const svg = { claude, codex, opencode, openhands }[agent];
---

<span class:list={["agent-logo", cls]} aria-hidden="true" set:html={svg} />

<style>
  .agent-logo {
    display: inline-flex;
  }
  .agent-logo :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
