---
import Rich from "./Rich.astro";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="hero" id="top">
  <div class="hero-field" aria-hidden="true"><canvas data-field></canvas></div>
  <div class="hero-center">
    <p class="hero-kicker rise">{d.hero.kicker}</p>
    <h1 class="display rise d1"><Rich segs={d.hero.title} /></h1>
    <div class="cta-col rise d2">
      <DownloadButton lang={lang} />
      <a class="link-more" href="https://github.com/Jia-Ethan/keysmith-lens" target="_blank" rel="noopener"><span>GitHub</span><Icon name="out" /></a>
    </div>
  </div>
  <slot />
</section>

<script>
  // A sparse field of mono glyphs drifting behind the hero, like Keysmith's
  // braces and keys seen through paper. Static when motion is reduced.
  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const GLYPHS = "{}[]<>/=-+:;.*#~_".split("");
    const PITCH = 11;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let w = 0,
      h = 0,
      dpr = 1,
      t = 0,
      visible = true,
      last = 0;
    const seed = Math.random() * 1000;
    // Cheap value noise.
    const hash = (x: number, y: number) => {
      const s = Math.sin(x * 127.1 + y * 311.7 + seed) * 43758.5453;
      return s - Math.floor(s);
    };
    const noise = (x: number, y: number) => {
      const xi = Math.floor(x),
        yi = Math.floor(y),
        xf = x - xi,
        yf = y - yi;
      const u = xf * xf * (3 - 2 * xf),
        v = yf * yf * (3 - 2 * yf);
      const a = hash(xi, yi),
        b = hash(xi + 1, yi),
        c = hash(xi, yi + 1),
        d = hash(xi + 1, yi + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    };
    const resize = () => {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      draw();
    };
    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const ink = getComputedStyle(document.documentElement).getPropertyValue("--ink-1").trim() || "#1c1915";
      ctx.fillStyle = ink;
      ctx.font = `600 9px "IBM Plex Mono", ui-monospace, monospace`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      const cx = w / 2;
      for (let y = PITCH; y < h; y += PITCH) {
        for (let x = PITCH / 2; x < w; x += PITCH) {
          const n = noise(x / 150 + t * 0.03, y / 110 - t * 0.02);
          // Clear lane behind the headline and buttons.
          const dx = Math.abs(x - cx) / Math.max(320, w * 0.3);
          const lane = Math.min(1, Math.max(0, dx - 0.55) * 2.4);
          const v = (n - 0.6) * 3.2 * lane;
          if (v <= 0) continue;
          const g = GLYPHS[Math.floor(hash(Math.round(x), Math.round(y + Math.floor(t * 0.4))) * GLYPHS.length)];
          ctx.globalAlpha = Math.min(0.2, v * 0.2);
          ctx.fillText(g, x, y);
        }
      }
      ctx.globalAlpha = 1;
    };
    const loop = (now: number) => {
      requestAnimationFrame(loop);
      if (!visible || now - last < 110) return;
      last = now;
      t += 0.11;
      draw();
    };
    resize();
    new ResizeObserver(resize).observe(canvas);
    window.addEventListener("ks-theme", () => draw());
    if (!reduce) {
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
      document.addEventListener("visibilitychange", () => (visible = !document.hidden));
      requestAnimationFrame(loop);
    }
  }
</script>
