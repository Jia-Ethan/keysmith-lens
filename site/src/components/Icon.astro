---
// Small inline icons shared across the site. Stroke icons inherit currentColor.
type Name =
  | "download"
  | "arrow"
  | "chev"
  | "out"
  | "help"
  | "moon"
  | "sun"
  | "github"
  | "apple"
  | "windows"
  | "linux"
  | "play"
  | "pause"
  | "star"
  | "search"
  | "copy"
  | "check"
  | "expand"
  | "shield"
  | "plus"
  | "minus";
interface Props {
  name: Name;
  class?: string;
  size?: number;
}
const { name, class: cls, size } = Astro.props;
const dim = size ? { width: size, height: size } : {};
---

{name === "download" && (
  <svg class={cls} {...dim} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v11.5M7 10.5l5 5 5-5M4.5 19.5h15" /></svg>
)}
{name === "arrow" && (
  <svg class={cls} {...dim} viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 1.5 7 5l-3.5 3.5" /></svg>
)}
{name === "chev" && (
  <svg class={cls} {...dim} viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.8 5 6.8l3-3" /></svg>
)}
{name === "out" && (
  <svg class={cls} {...dim} viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7 7 3M3.6 3H7v3.4" /></svg>
)}
{name === "help" && (
  <svg class={cls} {...dim} width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M4.3 4.4a1.8 1.8 0 1 1 2.6 1.6c-.6.3-.9.7-.9 1.3v.3" /><circle cx="6" cy="9.6" r=".35" fill="currentColor" /></svg>
)}
{name === "moon" && (
  <svg class={cls} {...dim} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" /></svg>
)}
{name === "sun" && (
  <svg class={cls} {...dim} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.8v1.8M12 19.4v1.8M2.8 12h1.8M19.4 12h1.8M5.5 5.5l1.3 1.3M17.2 17.2l1.3 1.3M5.5 18.5l1.3-1.3M17.2 6.8l1.3-1.3" /></svg>
)}
{name === "github" && (
  <svg class={cls} {...dim} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.6a10.4 10.4 0 0 0-3.3 20.3c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.2-4.7-5.1 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a9.9 9.9 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.7 1.1 1.7 1.1 2.8 0 4-2.4 4.8-4.7 5.1.4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10.4 10.4 0 0 0 12 1.6Z" /></svg>
)}
{name === "apple" && (
  <svg class={cls} {...dim} viewBox="0 0 17 20" fill="currentColor" aria-hidden="true"><path d="M14.1 10.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-1.9-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1.1-2.9-4.3ZM11.6 3.2c.7-.9 1.2-2 1-3.2-1 .1-2.2.7-3 1.6-.6.7-1.2 1.9-1 3.1 1.1.1 2.2-.6 3-1.5Z" /></svg>
)}
{name === "windows" && (
  <svg class={cls} {...dim} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M0 2.8 8.2 1.7v7.9H0V2.8Zm9.2-1.2L20 0v9.6H9.2v-8ZM0 10.5h8.2v7.9L0 17.2v-6.7Zm9.2 0H20V20l-10.8-1.5v-8Z" /></svg>
)}
{name === "linux" && (
  <svg class={cls} {...dim} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1c-2 0-3.2 1.7-3.2 4 0 1.2.2 2-.6 3.3C5.2 9.8 4 11.5 4 13.6c0 .6.1 1.1.3 1.6-.6.4-1.5.6-1.5 1.5 0 1 1.4 1.1 2.4 1.5 1 .4 1.6 1 2.6 1 .9 0 1.4-.6 2.2-.6s1.3.6 2.2.6c1 0 1.6-.6 2.6-1s2.4-.5 2.4-1.5c0-.9-.9-1.1-1.5-1.5.2-.5.3-1 .3-1.6 0-2.1-1.2-3.8-2.2-5.3-.8-1.3-.6-2.1-.6-3.3C13.2 2.7 12 1 10 1Zm-1.3 3.4c.4 0 .7.5.7 1s-.3 1-.7 1-.7-.5-.7-1 .3-1 .7-1Zm2.6 0c.4 0 .7.5.7 1s-.3 1-.7 1-.7-.5-.7-1 .3-1 .7-1Z" /></svg>
)}
{name === "play" && (
  <svg class={cls} {...dim} viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.6v8.8L10.2 6 3 1.6Z" /></svg>
)}
{name === "pause" && (
  <svg class={cls} {...dim} viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2.4" y="1.8" width="2.4" height="8.4" rx=".6" /><rect x="7.2" y="1.8" width="2.4" height="8.4" rx=".6" /></svg>
)}
{name === "star" && (
  <svg class={cls} {...dim} viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="m6 .9 1.55 3.32 3.63.43-2.68 2.48.71 3.58L6 8.93 2.79 10.71l.71-3.58L.82 4.65l3.63-.43L6 .9Z" /></svg>
)}
{name === "search" && (
  <svg class={cls} {...dim} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="4.6" /><path d="m10.4 10.4 3.6 3.6" /></svg>
)}
{name === "copy" && (
  <svg class={cls} {...dim} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.6" /><path d="M10.5 5.5V3.8c0-.9-.7-1.6-1.6-1.6H3.8c-.9 0-1.6.7-1.6 1.6v5.1c0 .9.7 1.6 1.6 1.6h1.7" /></svg>
)}
{name === "check" && (
  <svg class={cls} {...dim} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.4 2.9 2.9 6.1-6.6" /></svg>
)}
{name === "expand" && (
  <svg class={cls} {...dim} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.4 1.6h3v3M10.4 1.6 7 5M4.6 10.4h-3v-3M1.6 10.4 5 7" /></svg>
)}
{name === "shield" && (
  <svg class={cls} {...dim} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.8 13 3.6v4.1c0 3.1-2.1 5.4-5 6.5-2.9-1.1-5-3.4-5-6.5V3.6L8 1.8Z" /></svg>
)}
{name === "plus" && (
  <svg class={cls} {...dim} viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M5 1.8v6.4M1.8 5h6.4" /></svg>
)}
{name === "minus" && (
  <svg class={cls} {...dim} viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M1.8 5h6.4" /></svg>
)}
