---
import { getCollection } from "astro:content";
import Doc from "../../views/Doc.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs", (e) => e.id.startsWith("zh/"));
  return docs.map((entry) => ({ params: { slug: entry.data.page }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Doc lang="zh" entry={entry} />
