---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { t, href, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} title={d.notFound.title} noindex>
  <section class="wrap page-top nf">
    <h1 class="display">{d.notFound.title}</h1>
    <p class="lead">{d.notFound.body}</p>
    <p class="nf-links">
      <a class="text-link" href={href(lang, "/")}>{d.notFound.home}</a>
      <span aria-hidden="true">·</span>
      <a class="text-link" href={href(lang, "/docs/")}>{d.nav.docsIndex}</a>
      <span aria-hidden="true">·</span>
      <a class="text-link" href={href(lang, "/download/")}>{d.nav.download}</a>
      <span aria-hidden="true">·</span>
      <a class="text-link" href={href(lang, "/help/")}>{d.nav.help}</a>
    </p>
    <a class="btn-ink" href={href(lang, "/download/")}>{d.nav.cta}<Icon name="download" /></a>
  </section>
</Base>

<style>
  .nf {
    min-height: 62vh;
  }
  .nf .display {
    max-width: 520px;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.12;
  }
  .nf .lead {
    margin-top: 24px;
    max-width: 600px;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 30px 0 34px;
    font-size: 17px;
    color: var(--ink-3);
  }
</style>
