---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { t, href, type Lang } from "../i18n/ui";
import { DISCUSSIONS } from "../lib/release";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"docs">;
}
const { lang, entry } = Astro.props;
const d = t(lang).docs;
const all = (await getCollection("docs", (e) => e.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(all.map((e) => e.data.group))].map((g) => ({ name: g, items: all.filter((e) => e.data.group === g) }));
const i = all.findIndex((e) => e.id === entry.id);
const prev = all[i - 1];
const next = all[i + 1];
const { headings } = await render(entry);
// Links in the Markdown are written from the site root; give them the base path.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const html = (entry.rendered?.html ?? "").replace(/href="\/(?!\/)/g, `href="${BASE}/`);
const toc = headings.filter((h) => h.depth === 2);
const num = (n: number) => String(n).padStart(2, "0");
const chapterLabel = lang === "zh" ? `${d.chapter} ${num(entry.data.order)} ${d.chapterSuffix}` : `${d.chapter} ${num(entry.data.order)}`;
---

<Base lang={lang} title={entry.data.title} description={entry.data.lede} active="docs">
  <div class="wrap page-top docs" data-search-url={href(lang, "/docs/search.json")}>
    <p class="docs-title display">{d.title}</p>
    <div class="docs-grid">
      <aside class="docs-nav">
        <label class="docs-search">
          <Icon name="search" />
          <input type="search" placeholder={d.search} aria-label={d.search} data-docs-search autocomplete="off" />
        </label>
        <ul class="docs-results" data-docs-results hidden></ul>
        <p class="docs-none" data-docs-none hidden>{d.noResults}</p>
        <nav aria-label={d.title} data-docs-groups>
          {
            groups.map((g) => (
              <div class="docs-group">
                <p class="docs-group-h">{g.name}</p>
                <ol>
                  {g.items.map((e) => (
                    <li>
                      <a href={href(lang, `/docs/${e.data.page}/`)} class:list={{ on: e.id === entry.id }} aria-current={e.id === entry.id ? "page" : undefined}>
                        <span class="mono">{num(e.data.order)}</span>
                        {e.data.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
        </nav>
      </aside>

      <article class="docs-body">
        <p class="docs-chapter mono">{chapterLabel}</p>
        <h1 class="docs-h1 serif">{entry.data.title}</h1>
        <p class="docs-lede">{entry.data.lede}</p>
        <div class="prose" data-prose set:html={html} />
        <nav class="docs-pager" aria-label={`${d.prev} / ${d.next}`}>
          {
            prev ? (
              <a class="pager prev" href={href(lang, `/docs/${prev.data.page}/`)}>
                <small>{d.prev}</small>
                <span>{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="pager next" href={href(lang, `/docs/${next.data.page}/`)}>
                <small>{d.next}</small>
                <span>{next.data.title}</span>
              </a>
            )
          }
        </nav>
        <p class="docs-edit">
          <a class="text-link" href={DISCUSSIONS} target="_blank" rel="noopener">{d.edit}</a>
        </p>
      </article>

      <aside class="docs-toc" aria-label={d.onThisPage}>
        {
          toc.length > 0 && (
            <>
              <p class="docs-toc-h">{d.onThisPage}</p>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </aside>
    </div>
  </div>
</Base>

<script>
  // Sidebar search over the full text of every chapter; the index loads on first use.
  const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
  const results = document.querySelector<HTMLUListElement>("[data-docs-results]")!;
  const none = document.querySelector<HTMLElement>("[data-docs-none]")!;
  const groups = document.querySelector<HTMLElement>("[data-docs-groups]")!;
  const url = document.querySelector<HTMLElement>("[data-search-url]")?.dataset.searchUrl ?? "";
  type Entry = { t: string; k: string; u: string };
  let index: Promise<Entry[]> | undefined;
  const load = () => (index ??= fetch(url).then((r) => (r.ok ? r.json() : [])).catch(() => []));
  input?.addEventListener("focus", () => void load(), { once: true });
  input?.addEventListener("input", async () => {
    const q = input.value.trim().toLowerCase();
    if (!q) {
      results.hidden = true;
      none.hidden = true;
      groups.hidden = false;
      return;
    }
    const all: Entry[] = await load();
    if (input.value.trim().toLowerCase() !== q) return;
    // Title matches first, then text matches.
    const hits = all.filter((e) => e.t.toLowerCase().includes(q)).concat(all.filter((e) => !e.t.toLowerCase().includes(q) && e.k.toLowerCase().includes(q)));
    results.replaceChildren(
      ...hits.map((h) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = h.u;
        a.textContent = h.t;
        li.append(a);
        return li;
      }),
    );
    results.hidden = hits.length === 0;
    none.hidden = hits.length > 0;
    groups.hidden = true;
  });

  // Highlight the section in view.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].map((a) => [a.dataset.tocLink!, a]));
  const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const update = () => {
    let current = heads[0]?.id;
    for (const h of heads) if (h.getBoundingClientRect().top < 140) current = h.id;
    for (const [id, a] of links) a.classList.toggle("on", id === current);
  };
  if (heads.length) {
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  // Copy buttons on code blocks.
  for (const pre of document.querySelectorAll<HTMLPreElement>("[data-prose] pre")) {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-code";
    btn.textContent = document.documentElement.lang.startsWith("zh") ? "复制" : "Copy";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n?(复制|Copy)$/, ""));
        const before = btn.textContent;
        btn.textContent = document.documentElement.lang.startsWith("zh") ? "已复制" : "Copied";
        setTimeout(() => (btn.textContent = before), 1600);
      } catch {}
    });
    pre.append(btn);
  }
</script>

<style>
  .docs-title {
    font-size: clamp(32px, 3.6vw, 52px);
  }
  :lang(zh) .docs-title {
    font-size: clamp(28px, 3vw, 42px);
  }
  .docs-grid {
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr) 190px;
    gap: clamp(28px, 3.6vw, 56px);
    margin-top: clamp(44px, 6vh, 64px);
  }
  .docs-nav,
  .docs-toc {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .docs-search {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 36px;
    padding: 0 11px;
    border: 1px solid var(--line-2);
    border-radius: 5px;
    background: var(--surface);
    color: var(--ink-3);
  }
  .docs-search :global(svg) {
    width: 14px;
    height: 14px;
    flex: none;
  }
  .docs-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    outline: none;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-1);
  }
  .docs-search:focus-within {
    border-color: var(--ink-2);
  }
  .docs-results {
    margin-top: 12px;
  }
  .docs-results a,
  .docs-group a {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--ink-2);
    transition: background var(--t-2) var(--e-out), color var(--t-2) var(--e-out);
  }
  .docs-none {
    margin-top: 14px;
    padding: 0 12px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .docs-group {
    margin-top: 20px;
  }
  .docs-group-h {
    margin-bottom: 4px;
    padding: 0 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-1);
  }
  .docs-group a .mono {
    font-size: 10.5px;
    color: var(--ink-3);
  }
  .docs-results a:hover,
  .docs-group a:hover {
    color: var(--ink-1);
  }
  .docs-group a.on {
    color: var(--ink-1);
    background: rgba(var(--rule), 0.07);
  }
  .docs-group a.on .mono {
    color: var(--accent);
  }
  .docs-chapter {
    font-size: 12px;
    color: var(--ink-3);
  }
  .docs-h1 {
    margin-top: 12px;
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.2;
  }
  .docs-lede {
    margin-top: 16px;
    max-width: 620px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 56px;
  }
  .pager {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    transition: border-color var(--t-2) var(--e-out);
  }
  .pager:hover {
    border-color: var(--ink-2);
  }
  .pager small {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .pager span {
    font-size: 15px;
    color: var(--ink-1);
  }
  .pager.next {
    grid-column: 2;
    text-align: right;
  }
  .docs-edit {
    margin-top: 24px;
    font-size: 13.5px;
  }
  .docs-toc-h {
    margin-bottom: 10px;
    font-size: 13.5px;
    font-weight: 600;
  }
  .docs-toc a {
    display: block;
    padding: 5px 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-3);
    transition: color var(--t-2) var(--e-out);
  }
  .docs-toc a:hover,
  .docs-toc a.on {
    color: var(--ink-1);
  }
  @media (max-width: 1180px) {
    .docs-grid {
      grid-template-columns: 232px minmax(0, 1fr);
    }
    .docs-toc {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .docs-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-nav {
      position: static;
      max-height: none;
    }
  }
</style>
